# ============================================================
# LLM — языковая модель (OpenAI или совместимый провайдер)
# Текущий провайдер: polza.ai (OpenAI-совместимый)
# ============================================================
LLM_BASE_URL=https://api.polza.ai/api/v1
LLM_API_KEY=ваш-ключ-polza-ai
LLM_MODEL=gpt-4o-mini

# ============================================================
# Yclients — система онлайн-бронирования
# Токены берите в кабинете Yclients: Настройки → API
# ============================================================
YCLIENTS_TOKEN=...
YCLIENTS_COMPANY_ID=...
YCLIENTS_STAFF_ID=...

# ============================================================
# Chatwoot — если используете Chatwoot (опционально)
# Оставьте пустым, если работаете только через Jivo
# ============================================================
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_TOKEN=...
CHATWOOT_ACCOUNT_ID=...

# ============================================================
# App
# TENANT — тенант по умолчанию (для Chatwoot и /health).
#          Для Jivo тенант определяется прямо из URL: /jivo/{tenant_id}
#          Доступные тенанты: имена файлов в config/tenants/ без расширения .json
# PORT   — порт сервера
# ============================================================
TENANT=coworking
PORT=8000

# ============================================================
# Jivo — токены ботов (ХРАНЯТСЯ В КОНФИГЕ ТЕНАНТА, не здесь!)
#
# Для каждого клиента/тенанта токен Jivo-бота указывается в его
# JSON-конфиге: config/tenants/<tenant_id>.json → поле "jivo_token"
#
# Как получить токен Jivo:
#   1. Войдите на jivosite.com
#   2. Управление → Боты → Создать бота
#   3. Скопируйте "Токен" и вставьте в "jivo_token" нужного тенанта
#   4. В поле "Webhook URL" вашего бота укажите:
#      https://ВАШ_ДОМЕН/jivo/TENANT_ID
#      Например: https://myserver.com/jivo/coworking
# ============================================================
